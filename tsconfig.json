{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "esModuleInterop": true,
    "resolveJsonModule": true,

    "strict": true,
    "verbatimModuleSyntax": false,

    "types": ["node", "@playwright/test"],

    "skipLibCheck": true
  },

  "include": [
    "tests/**/*.ts",
    "api/**/*.ts",
    "utils/**/*.ts",
    "config/**/*.ts"
  ]
}